{
  "name": "code-janitor",
  "displayName": "Code Janitor",
  "description": "Autocorrect and format code syntax for C, C++, .ino, Java, JavaScript, Python, and HTML inside VS Code.",
  "version": "0.8.4",
  "publisher": "Debanshu2005",
  "icon": "src/images/code-janitor.jpg",
  "license": "MIT",
  "homepage": "https://github.com/Debanshu2005/code-janitor",
  "bugs": {
    "url": "https://github.com/Debanshu2005/code-janitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Debanshu2005/code-janitor.git"
  },
  "keywords": ["formatter", "linter", "javascript", "python", "java", "c", "cpp", "html", "code-quality"],
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=18"
  },
  "categories": [
    "Formatters",
    "Linters",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Code Janitor",
      "properties": {
        "codeJanitor.autoCorrection.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time auto-correction as you type"
        },
        "codeJanitor.autoCorrection.delay": {
          "type": "number",
          "default": 500,
          "description": "Delay in milliseconds before auto-correction triggers (default: 500ms)"
        },
        "codeJanitor.autoCorrection.languages": {
          "type": "array",
          "default": ["python", "javascript", "java", "c", "cpp", "html"],
          "description": "Languages to enable auto-correction for"
        },
        "codeJanitor.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-powered syntax fixing with Ollama (DISABLED - causes code corruption)"
        },
        "codeJanitor.ai.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama API URL"
        },
        "codeJanitor.ai.model": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Ollama model to use (qwen2.5-coder:1.5b for speed, codellama:latest for accuracy)"
        },
        "codeJanitor.ai.timeout": {
          "type": "number",
          "default": 90000,
          "description": "AI request timeout in milliseconds"
        }
      }
    },
    "commands": [
      {
        "command": "codeJanitor.fixCode",
        "title": "Format Code",
        "category": "Code Janitor"
      },
      {
        "command": "codeJanitor.lintCode",
        "title": "Lint Code (ESLint)",
        "category": "Code Janitor"
      },
      {
        "command": "codeJanitor.livePreview",
        "title": "Live HTML/React Preview (Unsaved)",
        "category": "Code Janitor"
      },
      {
        "command": "codeJanitor.validateFrontend",
        "title": "Validate Frontend Dependencies",
        "category": "Code Janitor"
      },
      {
        "command": "codeJanitor.openChat",
        "title": "Open AI Chat",
        "category": "Code Janitor"
      }
    ],
    "menus": {
      "command-palette": [
        {
          "command": "codeJanitor.fixCode"
        },
        {
          "command": "codeJanitor.lintCode"
        },
        {
          "command": "codeJanitor.livePreview"
        },
        {
          "command": "codeJanitor.validateFrontend"
        },
        {
          "command": "codeJanitor.openChat"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeJanitor.fixCode",
        "key": "alt+d",
        "mac": "alt+d"
      },
      {
        "command": "codeJanitor.lintCode",
        "key": "alt+l",
        "mac": "alt+l"
      },
      {
        "command": "codeJanitor.livePreview",
        "key": "alt+p",
        "mac": "alt+p"
      },
      {
        "command": "codeJanitor.validateFrontend",
        "key": "alt+v",
        "mac": "alt+v",
        "when": "editorTextFocus && (resourceExtname == '.html' || resourceExtname == '.css' || resourceExtname == '.js' || resourceExtname == '.jsx' || resourceExtname == '.tsx')"
      },
      {
        "command": "codeJanitor.openChat",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ]
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint --fix src/**/*.js",
    "format:js": "prettier --write \"src/**/*.js\"",
    "format:java": "C:\\nvm4w\\nodejs\\google-java-format -r src/**/*.java",
    "format:py": "C:\\nvm4w\\nodejs\\black src/",
    "format:c": "C:\\nvm4w\\nodejs\\uncrustify -c src/core/fixers/uncrustify.cfg --replace src/**/*.{c,h,ino}",
    "format:html": "prettier --write \"src/**/*.html\"",
    "format": "npm run format:js && npm run format:java && npm run format:py && npm run format:c && npm run format:html",
    "clean": "rimraf ./out",
    "package": ".\\node_modules\\.bin\\vsce.cmd package",
    "publish": ".\\node_modules\\.bin\\vsce.cmd publish"
  },

  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/generator": "^7.26.2",
    "@babel/parser": "^7.26.2",
    "@babel/traverse": "^7.25.9",
    "@babel/types": "^7.26.0",
    "eslint": "^8.57.1",
    "fs-extra": "^11.3.2",
    "parse5": "^8.0.0",
    "prettier": "^3.6.2",
    "parent-module": "^1.0.1",
    "import-fresh": "^3.3.0",
    "globals": "^13.24.0",
    "glob-parent": "^6.0.2"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.32.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "rimraf": "^5.0.1"
  },
  "extensionDependencies": [],
  "extensionPack": []
}
