# Exclude everything by default.
**

# Include extension source files and assets needed at runtime.
!src/**/*.js
!src/**/*.html
!src/**/*.py
!src/**/*.cfg
!src/**/*.png
!src/**/*.jpg

# Include extension metadata.
!package.json
!README.md
!LICENSE
!CHANGELOG.md

# Include only the formatter assets the packaged extension still uses.
!formatters/google-java-format/google-java-format.jar
!formatters/uncrustify/bin/**
!formatters/python-formatters/venv/pyvenv.cfg
!formatters/python-formatters/venv/Scripts/python.exe
!formatters/python-formatters/venv/Scripts/autopep8.exe
!formatters/python-formatters/venv/Scripts/black.exe
!formatters/python-formatters/venv/Lib/site-packages/30fcd23745efe32ce681__mypyc.cp313-win_amd64.pyd
!formatters/python-formatters/venv/Lib/site-packages/autopep8.py
!formatters/python-formatters/venv/Lib/site-packages/mypy_extensions.py
!formatters/python-formatters/venv/Lib/site-packages/pycodestyle.py
!formatters/python-formatters/venv/Lib/site-packages/_black_version.py
!formatters/python-formatters/venv/Lib/site-packages/_black_version.pyi
!formatters/python-formatters/venv/Lib/site-packages/autopep8-*.dist-info/**
!formatters/python-formatters/venv/Lib/site-packages/black/**
!formatters/python-formatters/venv/Lib/site-packages/black-*.dist-info/**
!formatters/python-formatters/venv/Lib/site-packages/blib2to3/**
!formatters/python-formatters/venv/Lib/site-packages/click/**
!formatters/python-formatters/venv/Lib/site-packages/click-*.dist-info/**
!formatters/python-formatters/venv/Lib/site-packages/colorama/**
!formatters/python-formatters/venv/Lib/site-packages/colorama-*.dist-info/**
!formatters/python-formatters/venv/Lib/site-packages/mypy_extensions-*.dist-info/**
!formatters/python-formatters/venv/Lib/site-packages/packaging/**
!formatters/python-formatters/venv/Lib/site-packages/packaging-*.dist-info/**
!formatters/python-formatters/venv/Lib/site-packages/pathspec/**
!formatters/python-formatters/venv/Lib/site-packages/pathspec-*.dist-info/**
!formatters/python-formatters/venv/Lib/site-packages/platformdirs/**
!formatters/python-formatters/venv/Lib/site-packages/platformdirs-*.dist-info/**
!formatters/python-formatters/venv/Lib/site-packages/pycodestyle-*.dist-info/**
!formatters/python-formatters/venv/Lib/site-packages/pytokens/**
!formatters/python-formatters/venv/Lib/site-packages/pytokens-*.dist-info/**

# Include only the runtime node modules the extension loads.
node_modules/**
!node_modules/@babel/**
!node_modules/eslint/**
!node_modules/@eslint/**
!node_modules/fs-extra/**
!node_modules/parse5/**
!node_modules/prettier/**
!node_modules/universalify/**
!node_modules/graceful-fs/**
!node_modules/jsonfile/**
!node_modules/entities/**
!node_modules/espree/**
!node_modules/esquery/**
!node_modules/estraverse/**
!node_modules/esutils/**
!node_modules/acorn/**
!node_modules/acorn-jsx/**
!node_modules/parent-module/**
!node_modules/import-fresh/**
!node_modules/callsites/**
!node_modules/globals/**
!node_modules/glob-parent/**

# Exclude tests and docs from included modules.
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/*.md
node_modules/**/docs/**
node_modules/**/examples/**

# Exclude development files.
.vscode/**
.vscode-test/**
test/**
tests/**
**/*test*
**/*.test.*
**/*.spec.*
test-*
test_*
**/test-*
**/test_*
.gitignore
.yarnrc
vsc-extension-quickstart.md
.eslintrc.*
jsconfig.json
tsconfig.json

# Exclude documentation and examples.
**/*.md
!README.md
!CHANGELOG.md
**/docs/**
**/examples/**
**/demo/**

# Exclude build artifacts.
**/*.vsix
**/out/**
**/dist/**
**/build/**

# Exclude temporary and cache files.
temp_*
**/temp_*
**/*.tmp
**/*.temp
**/*.backup.*
**/.python-fixer-backups/**
**/*.unc-backup*
**/*.uncrustify
**/*.md5~
Untitled-*
**/*.zip
**/__pycache__/**
**/*.pyc
**/*.pyo

# Exclude OS and IDE files.
.DS_Store
Thumbs.db
**/.idea/**
**/*.swp
**/*.swo

# Exclude logs and coverage artifacts.
**/*.log
**/logs/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/coverage/**
**/.nyc_output/**
**/*.tgz
**/.yarn-integrity
