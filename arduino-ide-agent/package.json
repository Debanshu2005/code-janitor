{
  "name": "code-janitor-arduino-ai-agent",
  "displayName": "Code Janitor Arduino AI Agent",
  "description": "Arduino-focused AI coding assistant from Code Janitor for Arduino IDE 2.x (VSIX plugin).",
  "version": "1.8.0",
  "publisher": "Debanshu2005",
  "repository": {
    "type": "git",
    "url": "https://github.com/Debanshu2005/code-janitor.git"
  },
  "icon": "src/images/code-janitor.jpg",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "configuration": {
      "title": "Code Janitor Arduino AI Agent",
      "properties": {
        "codeJanitor.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI chat"
        },
        "codeJanitor.ai.provider": {
          "type": "string",
          "default": "ollama",
          "enum": [
            "ollama",
            "groq",
            "openrouter",
            "anthropic",
            "nvidia"
          ],
          "description": "AI provider"
        },
        "codeJanitor.ai.nvidiaApiKey": {
          "type": "string",
          "default": "",
          "description": "NVIDIA API key"
        },
        "codeJanitor.ai.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key"
        },
        "codeJanitor.ai.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "Groq API key"
        },
        "codeJanitor.ai.openrouterApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenRouter API key"
        },
        "codeJanitor.ai.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama API URL"
        },
        "codeJanitor.ai.model": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "AI model. Recommended: qwen2.5-coder:1.5b for Ollama, llama-3.1-8b-instant for Groq, minimaxai/minimax-m2.7 for NVIDIA."
        },
        "codeJanitor.ai.nvidiaModel": {
          "type": "string",
          "default": "minimaxai/minimax-m2.7",
          "enum": [
            "minimaxai/minimax-m2.7",
            "meta/llama-3.1-8b-instruct",
            "meta/llama-3.1-70b-instruct",
            "nvidia/llama-3.3-nemotron-super-49b-v1.5",
            "mistralai/mistral-nemotron"
          ],
          "description": "NVIDIA model"
        },
        "codeJanitor.ai.timeout": {
          "type": "number",
          "default": 300000,
          "description": "AI timeout in milliseconds (default: 5 minutes). Increase if using slow models."
        }
      }
    },
    "commands": [
      {
        "command": "codeJanitorArduino.openChat",
        "title": "Open Arduino AI Chat",
        "category": "Code Janitor Arduino"
      },
      {
        "command": "codeJanitorArduino.openSourceControl",
        "title": "Open Source Control",
        "category": "Code Janitor Arduino"
      },
      {
        "command": "codeJanitorArduino.openGraphify",
        "title": "Visualize Project Graph",
        "category": "Code Janitor Arduino"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codeJanitorArduino.openChat"
        },
        {
          "command": "codeJanitorArduino.openSourceControl"
        },
        {
          "command": "codeJanitorArduino.openGraphify"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeJanitorArduino.openChat",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "codeJanitorArduino.openSourceControl",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "codeJanitorArduino.openGraphify",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      }
    ]
  },
  "scripts": {
    "package": "..\\node_modules\\.bin\\vsce.cmd package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.32.0"
  }
}
